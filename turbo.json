{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.env.*local"],
  "globalEnv": [
    "CI",
    "FAST_TRAVEL_API_URL",
    "FEE_LENDERS_PULSAR_3",
    "FEE_LENDER_SECRET_4",
    "GOOGLE_CLIENT_ID",
    "MAINTENANCE_MODE",
    "NEXT_PUBLIC_ENV",
    "NEXT_PUBLIC_FAST_TRAVEL_API_URL",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_THEME",
    "NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA",
    "NEXT_RUNTIME",
    "NODE_ENV",
    "PIMLICO_API_KEY",
    "SENTRY_AUTH_TOKEN",
    "VERCEL_ENV",
    "WALLETS_WORKER_SECRET_PRODUCTION",
    "WALLETS_WORKER_SECRET_STAGING"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "setup-ci": {
      "dependsOn": ["^setup-ci"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test-next": {
      "dependsOn": ["^test-next"]
    },
    "test-storybook": {
      "dependsOn": ["^test-storybook"]
    },
    "integration": {
      "dependsOn": ["^integration"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "tsc": {
      "dependsOn": ["^tsc"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
