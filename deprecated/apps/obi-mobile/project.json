{
  "name": "obi-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/obi-mobile/src",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "@nx/react-native:start",
      "options": {
        "port": 8081
      },
      "dependsOn": ["ensure-symlink", "sync-deps", "pod-install"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx start mobile"
      }
    },
    "run-ios": {
      "dependsOn": [
        "react-native-asset",
        "react-native-permissions",
        "ensure-symlink",
        "sync-deps",
        "pod-install"
      ],
      "executor": "@nx/react-native:run-ios",
      "options": {}
    },
    "bundle-ios": {
      "dependsOn": ["react-native-asset", "ensure-symlink"],
      "executor": "@nx/react-native:bundle",
      "outputs": ["{projectRoot}/build"],
      "options": {
        "entryFile": "src/main.tsx",
        "platform": "ios",
        "bundleOutput": "dist/apps/obi-mobile/ios/main.jsbundle"
      }
    },
    "run-android": {
      "dependsOn": ["react-native-asset", "ensure-symlink", "sync-deps"],
      "executor": "@nx/react-native:run-android",
      "options": {}
    },
    "build-android": {
      "dependsOn": ["react-native-asset", "ensure-symlink", "sync-deps"],
      "executor": "@nx/react-native:build-android",
      "outputs": [
        "{projectRoot}/android/app/build/outputs/bundle",
        "{projectRoot}/android/app/build/outputs/apk"
      ],
      "options": {}
    },
    "bundle-android": {
      "dependsOn": ["react-native-asset", "ensure-symlink"],
      "executor": "@nx/react-native:bundle",
      "options": {
        "entryFile": "src/main.tsx",
        "platform": "android",
        "bundleOutput": "dist/apps/obi-mobile/android/main.jsbundle"
      }
    },
    "sync-deps": {
      "executor": "@nx/react-native:sync-deps",
      "options": {}
    },
    "ensure-symlink": {
      "executor": "@nx/react-native:ensure-symlink",
      "options": {}
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/obi-mobile/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/obi-mobile"],
      "options": {
        "jestConfig": "apps/obi-mobile/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "react-native-asset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "react-native-asset",
        "cwd": "apps/obi-mobile"
      }
    },
    "react-native-permissions": {
      "executor": "nx:run-commands",
      "options": {
        "command": "react-native setup-ios-permissions"
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --project apps/obi-mobile/tsconfig.app.json --noEmit",
          "tsc --project apps/obi-mobile/tsconfig.spec.json --noEmit"
        ]
      }
    },
    "codepush": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/codepush.mjs"
      }
    }
  },
  "tags": []
}
