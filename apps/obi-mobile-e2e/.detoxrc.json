{
  "testRunner": {
    "$0": "jest",
    "args": {
      "config": "jest.config.ts"
    }
  },
  "apps": {
    "ios.debug": {
      "type": "ios.app",
      "binaryPath": "../../apps/obi-mobile/ios/build/Build/Products/Debug-iphonesimulator/Mobile.app"
    }
  },
  "devices": {
    "simulator-small": {
      "type": "ios.simulator",
      "device": {
        "type": "iPhone SE (3rd generation)"
      }
    },
    "simulator-large": {
      "type": "ios.simulator",
      "device": {
        "type": "iPhone 14 Pro Max"
      }
    }
  },
  "configurations": {
    "ios.sim.debug.small": {
      "device": "simulator-small",
      "app": "ios.debug"
    },
    "ios.sim.debug.large": {
      "device": "simulator-large",
      "app": "ios.debug"
    }
  }
}
