{
  "name": "config",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/config/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/config",
        "main": "libs/config/src/index.ts",
        "tsConfig": "libs/config/tsconfig.lib.json",
        "assets": [],
        "project": "libs/config/package.json",
        "rollupConfig": "@nx/react/plugins/bundle-rollup",
        "format": ["esm"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs config {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/config/**/*.ts"]
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tsc --project libs/config/tsconfig.lib.json --noEmit"]
      }
    }
  },
  "tags": []
}
