{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/theme/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/theme",
        "main": "libs/theme/src/index.ts",
        "tsConfig": "libs/theme/tsconfig.lib.json",
        "assets": [],
        "project": "libs/theme/package.json",
        "rollupConfig": "@nx/react/plugins/bundle-rollup",
        "format": ["esm"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs theme {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/theme/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/theme/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --project libs/theme/tsconfig.lib.json --noEmit",
          "tsc --project libs/theme/tsconfig.spec.json --noEmit"
        ]
      }
    }
  },
  "tags": []
}
