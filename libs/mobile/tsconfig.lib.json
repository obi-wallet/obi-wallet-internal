{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node"]
  },
  "exclude": [
    "jest.config.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "test-setup.ts"
