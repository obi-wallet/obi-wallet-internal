{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/mobile-shim/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "cosmos": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cosmos-native",
        "cwd": "libs/mobile"
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/mobile/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/mobile/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "tsc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --project libs/mobile/tsconfig.lib.json --noEmit",
          "tsc --project libs/mobile/tsconfig.spec.json --noEmit"
        ]
      }
    }
  }
}
