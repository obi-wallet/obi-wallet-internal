{
  "name": "obi-wallet-internal",
  "private": true,
  "workspaces": [
    "apps/*",
    "configs/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write . && yarn lint -- --fix",
    "integration": "turbo integration",
    "lint": "turbo lint",
    "prettier": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "setup-ci": "turbo setup-ci",
    "storybook": "turbo storybook",
    "test": "turbo test",
    "test-next": "turbo test-next",
    "test-storybook": "turbo test-storybook",
    "tsc": "turbo tsc"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-packagejson": "^2.5.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.1.3"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": "^20.0.0"
  }
}
