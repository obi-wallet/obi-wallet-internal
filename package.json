{
  "name": "obi-wallet-internal",
  "private": true,
  "workspaces": [
    "apps/*",
    "configs/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write . && yarn lint -- --fix",
    "integration": "turbo integration",
    "lint": "turbo lint",
    "prettier": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "setup-ci": "turbo setup-ci",
    "storybook": "turbo storybook",
    "test": "turbo test",
    "test-storybook": "turbo test-storybook",
    "test:bitcoin": "cd apps/web && vitest run --environment node src/tests/client/target-chain/bitcoin",
    "tsc": "turbo tsc"
  },
  "resolutions": {
    "cross-fetch@npm:3.1.5": "patch:cross-fetch@npm%3A3.1.5#~/.yarn/patches/cross-fetch-npm-3.1.5-e414995db9.patch",
    "eslint-plugin-react-hooks": "^5.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0"
  },
  "devDependencies": {
    "@types/is-core-module": "^2.2.2",
    "prettier": "^3.4.2",
    "prettier-plugin-packagejson": "^2.5.6",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3"
  },
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": "^20.0.0"
  }
}
