{
  "name": "obi-wallet-internal",
  "private": true,
  "workspaces": [
    "apps/*",
    "configs/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write . && yarn lint -- --fix",
    "lint": "turbo lint",
    "prettier": "prettier --check .",
    "setup": "node scripts/setup.mjs",
    "tsc": "turbo tsc"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "prettier-plugin-packagejson": "^2.4.7",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "turbo": "^1.12.0"
  },
  "packageManager": "yarn@4.0.2",
  "engines": {
    "node": "^20.0.0"
  }
}
